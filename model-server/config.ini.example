# Kittyhack model server
# Restart after a change:
#   Linux:   systemctl restart kittyhack-model-server
#   Windows: Restart-ScheduledTask -TaskName KittyhackModelServer
#   macOS:   launchctl kickstart -k gui/$(id -u)/de.kittyhack.model-server
#
# Only the listen port and the training parameters below are read.

[server]
# TCP port on this computer. Kittyhack connects to http://<this-host>:<port>
port = 8000

[training]
# Passed to Ultralytics YOLO.train.
# device: auto (GPU when this PyTorch build can see one; ROCm reports an AMD
# GPU as cuda:0, a Mac with Apple silicon uses mps), cpu, cuda:0, or mps
# batch: on a Mac the GPU shares the main memory. With 16 GB, use batch = 8
# for yolov8s at image size 512 or larger, or macOS may end the training
# when memory runs out.
epochs = 60
imgsz = 320
batch = 16
patience = 50
workers = 4
device = auto
